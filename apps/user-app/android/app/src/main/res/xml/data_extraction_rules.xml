<?xml version="1.0" encoding="utf-8"?>
<!-- Shifrlangan saqlash kaliti (Keystore) boshqa qurilmaga ko'chmaydi:
     zaxiradan tiklangan ma'lumot o'qilmaydi, shuning uchun hech narsa
     zaxiralanmaydi va ko'chirilmaydi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
