// Hokimiyat tizimi - backend data model
// Prisma schema: employees, attendance, citizen applications/chat, notifications, auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum MessageSenderRole {
  CITIZEN
  EMPLOYEE
  SYSTEM
}

enum AttachmentType {
  PHOTO
  VIDEO
}

enum NotificationType {
  GENERAL
  ATTENDANCE
  APPLICATION
  LOCATION
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum ZoneKind {
  DISTRICT
  MAHALLA
}

enum LocationSource {
  FOREGROUND
  BACKGROUND
  MANUAL
}

enum ApplicationEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  MESSAGE
}

// ---------------------------------------------------------------------------
// Departments (Bo'lim) — organizational units employees belong to and
// applications can be routed to.
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  employees    Employee[]
  applications Application[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Employees (Xodim)
// ---------------------------------------------------------------------------

model Employee {
  id            String       @id @default(uuid())
  fullName      String
  phone         String       @unique
  position      String
  region        String
  district      String
  role          EmployeeRole @default(EMPLOYEE)
  isActive      Boolean      @default(true)
  avatarUrl     String?
  email         String?      @unique
  // Employee login credentials (worker-app): employees sign in with
  // username + password (bcrypt), NOT OTP. Nullable so pre-existing rows and
  // OTP-era employees remain valid until a username/password is provisioned.
  username      String?      @unique
  passwordHash  String?
  departmentId  String?
  workStartTime String       @default("09:00")
  workEndTime   String       @default("18:00")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  // --- Geofence / office assignment (per employee; falls back to global env) ---
  officeLat       Float?
  officeLng       Float?
  officeRadiusM   Int?
  homeMahallaCode String?

  // --- Denormalized "latest location" for fast admin live-map + stale checks ---
  lastLat            Float?
  lastLng            Float?
  lastAccuracyM      Float?
  lastLocationAt     DateTime?
  lastMahallaCode    String?
  lastMahallaName    String?
  lastInsideDistrict Boolean   @default(false)
  lastInsideOffice   Boolean   @default(false)
  // Set when a "no location for N minutes" alert has already been raised for the
  // current stale episode, so the scheduler doesn't spam. Cleared on next report.
  staleAlertedAt     DateTime?

  faceTemplates        FaceTemplate[]
  attendanceRecords    AttendanceRecord[]
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  assignedApplications Application[]
  locations            EmployeeLocation[]
  pointsEntries        PointsEntry[]
  suggestions          Suggestion[]
  suggestionVotes      SuggestionVote[]
  leaveRequests        LeaveRequest[]
  bonusRequests        BonusRequest[]

  @@map("employees")
}

model FaceTemplate {
  id         String   @id @default(uuid())
  employeeId String
  embedding  Float[]
  enrolledAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("face_templates")
}

// ---------------------------------------------------------------------------
// Attendance (Davomat)
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id          String         @id @default(uuid())
  employeeId  String
  type        AttendanceType
  faceScore   Float
  latitude    Float
  longitude   Float
  isValid     Boolean
  reason      String?
  isLate      Boolean        @default(false)
  lateMinutes Int            @default(0)
  recordedAt  DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, recordedAt])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Applications / Complaints (Murojaat / Ariza)
// ---------------------------------------------------------------------------

model Application {
  id                   String            @id @default(uuid())
  applicantFullName    String
  applicantPhone       String
  subject              String
  description          String
  region               String?
  district             String?
  status               ApplicationStatus @default(NEW)
  assignedEmployeeId   String?
  assignedDepartmentId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assignedEmployee   Employee?            @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedDepartment Department?          @relation(fields: [assignedDepartmentId], references: [id])
  messages           ApplicationMessage[]
  attachments        Attachment[]
  events             ApplicationEvent[]

  @@index([status])
  @@index([applicantPhone])
  @@map("applications")
}

model ApplicationMessage {
  id            String            @id @default(uuid())
  applicationId String
  senderRole    MessageSenderRole
  senderName    String?
  text          String
  attachmentUrl String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_messages")
}

model Attachment {
  id            String         @id @default(uuid())
  applicationId String
  type          AttachmentType
  url           String
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  uploadedAt    DateTime       @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("attachments")
}

model ApplicationEvent {
  id              String               @id @default(cuid())
  applicationId   String
  type            ApplicationEventType
  fromStatus      ApplicationStatus?
  toStatus        ApplicationStatus?
  fromEmployeeId  String?
  toEmployeeId    String?
  departmentId    String?
  actorEmployeeId String?
  note            String?
  createdAt       DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(uuid())
  employeeId String
  title      String
  body       String
  type       NotificationType @default(GENERAL)
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Push notification device tokens (FCM)
// ---------------------------------------------------------------------------
// One row per installed app instance. The worker-app registers its Firebase
// Cloud Messaging token after login; the backend fans a push out to every
// token an employee owns. Tokens rotate, so `token` is unique and dead tokens
// are pruned automatically when FCM reports them unregistered on send.

model DeviceToken {
  id         String         @id @default(uuid())
  employeeId String
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("device_tokens")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ---------------------------------------------------------------------------
// Auth (phone + SMS OTP)
// ---------------------------------------------------------------------------

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_challenges")
}

model RefreshToken {
  id         String   @id @default(uuid())
  employeeId String
  tokenHash  String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Admin panel users (web-admin login/password auth — separate from employees)
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Zones (Hudud) — administrative boundaries: district (tuman) + mahallas.
// Seeded from real GIS shapefiles (Mirzo Ulug'bek tumani, 70 mahallas).
// `geometry` holds a GeoJSON geometry object (coords in [lng, lat] order).
// ---------------------------------------------------------------------------

model Zone {
  id          String   @id @default(uuid())
  kind        ZoneKind
  code        String   @unique // KOD for mahalla, district code for district
  soato       String?
  nameUzLat   String
  nameUzCyr   String?
  nameRu      String?
  parentCode  String? // mahalla -> district code
  centroidLat Float
  centroidLng Float
  minLat      Float
  minLng      Float
  maxLat      Float
  maxLng      Float
  areaM2      Float?
  geometry    Json // GeoJSON geometry (Polygon | MultiPolygon), [lng, lat]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@map("zones")
}

// ---------------------------------------------------------------------------
// Employee location time-series (doimiy lokatsiya) — one row per GPS report.
// The server derives mahalla + office-geofence membership on ingest.
// ---------------------------------------------------------------------------

model EmployeeLocation {
  id                String         @id @default(uuid())
  employeeId        String
  latitude          Float
  longitude         Float
  accuracy          Float?
  speed             Float?
  heading           Float?
  battery           Int?
  source            LocationSource @default(FOREGROUND)
  mahallaCode       String?
  mahallaName       String?
  insideDistrict    Boolean        @default(false)
  insideOffice      Boolean        @default(false)
  distanceToOfficeM Float?
  recordedAt        DateTime // device timestamp
  createdAt         DateTime       @default(now()) // server receive timestamp

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, recordedAt])
  @@map("employee_locations")
}

// ===========================================================================
// WEB-ADMIN DOMAIN MODELS
// ---------------------------------------------------------------------------
// These models mirror the web-admin mock contract
// (apps/web-admin/src/shared/data/{types,mock}.ts). Every endpoint that serves
// one of these must return JSON that is a drop-in replacement for the matching
// mock export: identical field names + nesting, dates as ISO strings, and the
// literal enum values below (kept lowercase on purpose so the JSON matches the
// TypeScript union types exactly — e.g. status "in_progress", category
// "kommunal"). Enum member names double as the wire value; do NOT @map them.
//
// Nested value-objects (attendance days, worker documents, complaint responses,
// app-user activity points, staff schedule, district center/polygon) are stored
// as Json so the persisted shape is byte-identical to the mock's nested arrays.
//
// Large monetary figures (utility/finance) use Float, not Int/BigInt: the values
// exceed the 32-bit Int range, and Float serialises cleanly to a JSON number
// (BigInt would throw in JSON.stringify and break the drop-in contract).
//
// NOTE: all admin endpoints backed by these models are @Public() for this TEST
// deployment; auth-gating them is a later config step.
// ===========================================================================

// ---- Enums (lowercase literals mirror the web-admin TS unions) -------------

enum RequestCategory {
  kommunal
  yol
  suv
  elektr
  tozalik
  obodonlashtirish
}

enum RequestStatus {
  new
  in_progress
  resolved
  rejected
}

enum Priority {
  low
  medium
  high
}

enum WorkerStatus {
  online
  offline
  on_task
  break
}

enum UtilityType {
  suv
  gaz
  elektr
  issiqlik
  tozalik
  internet
}

enum CameraType {
  fixed
  ptz
  anpr
  thermal
}

enum CameraStatus {
  online
  offline
  maintenance
}

enum GovDocType {
  qaror
  buyruq
  hisobot
  shartnoma
  ariza
  dalolatnoma
}

enum GovDocStatus {
  draft
  review
  signed
  archived
}

enum StaffRole {
  hokim
  hokim_yordamchisi
  bolim_boshligi
  operator
  nazoratchi
  ishchi
}

enum StaffStatus {
  active
  inactive
  suspended
}

enum ModuleKey {
  dashboard
  requests
  map
  workers
  attendance
  staff
  cameras
  finance
  analytics
  documents
  news
  settings
}

enum NewsCategory {
  elon
  tadbir
  qaror
  ogohlantirish
  yangilik
}

enum NewsStatus {
  published
  draft
}

enum AppUserStatus {
  active
  inactive
  blocked
}

enum AppUserDevice {
  android
  ios
}

enum AdminNotificationType {
  request
  worker
  finance
  camera
  system
}

enum ComplaintStatus {
  new
  reviewing
  resolved
  rejected
}

enum ComplaintSeverity {
  low
  medium
  high
}

enum MeetingType {
  apparat
  qabul
  shtab
  video
  hashar
}

enum MeetingStatus {
  scheduled
  ongoing
  done
  cancelled
}

// ---- District (Tuman) ------------------------------------------------------
// id is the stable slug ("mirzo", "chilonzor", ...). center = [lat,lng];
// polygon = [lat,lng][] — both kept as Json to preserve the tuple shape.

model District {
  id         String   @id
  name       String
  center     Json // [lat, lng]
  polygon    Json // [lat, lng][]
  color      String
  population Int
  households Int
  areaKm2    Float
  createdAt  DateTime @default(now())

  @@map("districts")
}

// ---- Worker (dala ishchisi) ------------------------------------------------

model Worker {
  id             String            @id // "w1"
  name           String
  photo          String
  avatarColor    String
  position       String
  region         String
  districtId     String
  phone          String
  email          String
  specialization RequestCategory[]
  status         WorkerStatus
  insideRegion   Boolean
  rating         Float
  points         Int
  completedTasks Int
  activeTasks    Int
  lat            Float
  lng            Float
  hiredAt        DateTime
  checkInTime    String? // "08:12" (clock time, not a date)
  checkOutTime   String?
  todayConfirmed Boolean
  attendanceRate Int
  onTimeRate     Int
  monthlyHours   Int
  attendance     Json // AttendanceDay[]
  salary         Int
  bonus          Int
  vehicle        String?
  documents      Json // WorkerDocument[]
  createdAt      DateTime          @default(now())

  @@index([districtId])
  @@index([status])
  @@map("workers")
}

// ---- CitizenRequest (Murojaat) — the REQUESTS export -----------------------

model CitizenRequest {
  id               String          @id // "R-1000"
  title            String
  description      String
  category         RequestCategory
  status           RequestStatus
  region           String
  districtId       String
  address          String
  citizenName      String
  citizenPhone     String
  citizenPhoto     String
  createdAt        DateTime
  resolvedAt       DateTime?
  assignedWorkerId String?
  priority         Priority
  lat              Float
  lng              Float
  photos           String[]
  responseHours    Int?
  feedback         Int?
  cost             Int

  @@index([status])
  @@index([category])
  @@index([districtId])
  @@map("citizen_requests")
}

// ---- Staff (Xodim / tizim foydalanuvchisi) ---------------------------------

model Staff {
  id          String      @id // "s1"
  name        String
  photo       String
  avatarColor String
  role        StaffRole
  position    String
  department  String
  email       String
  phone       String
  login       String
  status      StaffStatus
  permissions ModuleKey[]
  schedule    Json // { start, end, days: number[] }
  lastLogin   DateTime?
  createdAt   DateTime
  twoFactor   Boolean

  @@index([role])
  @@index([status])
  @@map("staff")
}

// ---- Deputy (Hokim o'rinbosari) --------------------------------------------

model Deputy {
  id             String            @id // "d1"
  name           String
  photo          String
  color          String
  position       String
  direction      String
  shortDirection String
  categories     RequestCategory[]
  topics         String[]
  phone          String
  email          String
  office         String
  receptionDay   String

  @@map("deputies")
}

// ---- Complaint (Shikoyat) — responses[] stored as Json ---------------------

model Complaint {
  id           String            @id // "SH-2000"
  title        String
  description  String
  topic        String
  severity     ComplaintSeverity
  status       ComplaintStatus
  districtId   String
  region       String
  address      String
  citizenName  String
  citizenPhone String
  citizenPhoto String
  createdAt    DateTime
  deadlineAt   DateTime
  resolvedAt   DateTime?
  deputyId     String
  isRepeat     Boolean
  escalated    Boolean
  responses    Json // ComplaintResponse[]

  @@index([status])
  @@index([deputyId])
  @@map("complaints")
}

// ---- AppUser (Mobil ilova foydalanuvchisi) — activity[] as Json ------------

model AppUser {
  id              String        @id // "au1"
  name            String
  phone           String
  photo           String
  avatarColor     String
  region          String
  districtId      String
  address         String
  device          AppUserDevice
  appVersion      String
  status          AppUserStatus
  verified        Boolean
  registeredAt    DateTime
  lastActiveAt    DateTime
  requestsCount   Int
  resolvedCount   Int
  avgRating       Float
  points          Int
  notificationsOn Boolean
  activity        Json // AppUserActivityPoint[]

  @@index([status])
  @@map("app_users")
}

// ---- AdminNotification (web-admin NotificationItem) ------------------------
// Named AdminNotification to avoid clashing with the existing employee-facing
// `Notification` model. JSON shape still matches the mock's NotificationItem.

model AdminNotification {
  id        String                @id // "ntf1"
  type      AdminNotificationType
  title     String
  message   String
  createdAt DateTime
  read      Boolean               @default(false)
  href      String?

  @@map("admin_notifications")
}

// ---- Camera (CCTV) — Tier 2 ------------------------------------------------

model Camera {
  id            String       @id // "CAM-01"
  name          String
  region        String
  districtId    String
  type          CameraType
  status        CameraStatus
  lat           Float
  lng           Float
  resolution    String
  recording     Boolean
  uptime        Float
  detections24h Int
  lastEvent     String?
  installedAt   DateTime

  @@index([status])
  @@index([districtId])
  @@map("cameras")
}

// ---- Meeting (Yig'ilish) — Tier 2 ------------------------------------------

model Meeting {
  id            String        @id // "YIG-3000"
  title         String
  type          MeetingType
  status        MeetingStatus
  startAt       DateTime
  durationMin   Int
  location      String
  chairDeputyId String
  agenda        String[]
  participants  Int
  districtId    String

  @@index([status])
  @@map("meetings")
}

// ---- NewsItem (Yangilik / e'lon) — Tier 2 ----------------------------------

model NewsItem {
  id          String       @id // "n1"
  title       String
  excerpt     String
  body        String
  category    NewsCategory
  status      NewsStatus
  cover       String
  author      String
  publishedAt DateTime
  views       Int
  featured    Boolean

  @@index([status])
  @@index([category])
  @@map("news_items")
}

// ---- GovDocument (Hokimiyat hujjati) — Tier 2 ------------------------------

model GovDocument {
  id        String       @id // "D-1"
  code      String
  title     String
  type      GovDocType
  status    GovDocStatus
  author    String
  region    String
  createdAt DateTime
  sizeKb    Int
  pages     Int

  @@index([type])
  @@index([status])
  @@map("gov_documents")
}

// ---- Utility & Finance monthly series — Tier 2 -----------------------------
// Large sums use Float (see header note on BigInt/JSON).

model UtilityPayment {
  id             String      @id // "olmazor-suv"
  type           UtilityType
  region         String
  districtId     String
  period         String // "2026-05"
  charged        Float
  collected      Float
  debt           Float
  households     Int
  collectionRate Float

  @@index([districtId])
  @@index([type])
  @@map("utility_payments")
}

model UtilityMonthly {
  month    String @id // "Iyul"
  suv      Float
  gaz      Float
  elektr   Float
  issiqlik Float
  tozalik  Float
  internet Float

  @@map("utility_monthly")
}

model FinanceMonthly {
  month     String @id // "Iyul"
  budget    Float
  spent     Float
  collected Float
  turnover  Float

  @@map("finance_monthly")
}

// ---- Chat (Suhbat) — group + direct staff conversations --------------------
// Mirrors web-admin's `shared/store/chat.ts` (`Conversation` / `ChatMessage`)
// exactly: field names/nesting match 1:1 so API responses are a drop-in
// replacement for the old in-store mock data. Enum member names double as the
// wire value (lowercase on purpose), same convention as the rest of this
// admin domain — do NOT @map them.

enum ChatConvKind {
  group
  direct
}

enum ChatMsgKind {
  text
  image
  file
  voice
}

enum ChatMsgStatus {
  sent
  delivered
  read
}

model ChatConversation {
  id          String       @id // "group-all" | "dm-<staffId>"
  kind        ChatConvKind
  title       String
  subtitle    String?
  avatarColor String?
  photo       String?
  staffId     String? // only for kind = direct
  online      Boolean      @default(false)
  // Archive: "clear chat" (tozalash) empties messages AND sets archived=true;
  // the main list requests archived=false, the Archive view requests true.
  archived    Boolean      @default(false)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages ChatMessage[]

  @@index([kind])
  @@index([archived])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String // "me" (admin) or a staff id
  kind           ChatMsgKind
  text           String?
  fileName       String?
  fileSize       Int?
  url            String?
  durationSec    Int?
  status         ChatMsgStatus @default(sent)
  // Set when the body was edited (allowed only while status != read).
  editedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Call log (Qo'ng'iroqlar tarixi) — 1:1 WebRTC voice/video signaling history.
// The backend only relays SDP/ICE + records the call lifecycle here; media is
// peer-to-peer. Feeds the call-history UI (missed/incoming/outgoing badges).
// ---------------------------------------------------------------------------
model CallLog {
  id          String    @id @default(uuid())
  callerId    String
  callerName  String
  calleeId    String
  calleeName  String
  media       String // 'audio' | 'video'
  // ringing | accepted | rejected | missed | cancelled | ended | busy
  status      String
  startedAt   DateTime  @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int       @default(0)

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@map("call_logs")
}

// ---------------------------------------------------------------------------
// Employee points / rating (Ball nazorati — worker-app)
// ---------------------------------------------------------------------------

model PointsEntry {
  id         String   @id @default(uuid())
  employeeId String
  reason     String
  delta      Int
  positive   Boolean
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("points_entries")
}

// ---------------------------------------------------------------------------
// Employee rationalization suggestions (Takliflar — worker-app)
// ---------------------------------------------------------------------------

enum SuggestionStatus {
  yangi
  korilmoqda
  qabulQilindi
  rad
}

model Suggestion {
  id        String           @id @default(uuid())
  authorId  String
  title     String
  body      String
  category  String
  status    SuggestionStatus @default(yangi)
  votes     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author      Employee         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  voteRecords SuggestionVote[]

  @@index([status])
  @@map("suggestions")
}

model SuggestionVote {
  id           String   @id @default(uuid())
  suggestionId String
  employeeId   String
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, employeeId])
  @@index([suggestionId])
  @@map("suggestion_votes")
}

// ---------------------------------------------------------------------------
// Employee leave requests (Ta'til / ruxsat so'rovi — worker-app)
// ---------------------------------------------------------------------------

enum LeaveType {
  hours
  days
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  amount     Int
  startDate  DateTime
  startTime  String?
  reason     String
  status     LeaveStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Employee bonuses (Premya — admin-granted, web-admin write / worker-app read)
// ---------------------------------------------------------------------------

model Bonus {
  id            String   @id @default(uuid())
  employeeId    String?
  workerId      String?
  recipientName String
  amount        Int
  reason        String
  month         String
  type          String   @default("premya")
  createdAt     DateTime @default(now())

  @@map("bonuses")
}

// Employee-initiated bonus REQUESTS (worker-app "Premya so'rash"): the employee
// asks for a premya; an admin later approves/rejects. Distinct from `Bonus`
// above, which is an admin-GRANTED award the employee only views.
enum BonusStatus {
  pending
  approved
  rejected
}

model BonusRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Int?
  reason     String
  status     BonusStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@index([employeeId])
  @@map("bonus_requests")
}
