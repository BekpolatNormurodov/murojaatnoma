// Hokimiyat tizimi - backend data model
// Prisma schema: employees, attendance, citizen applications/chat, notifications, auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/// What the citizen filed: an ordinary request (ariza) or a complaint
/// (shikoyat — stricter deadlines, escalated faster).
enum ApplicationKind {
  ARIZA
  SHIKOYAT
}

enum MessageSenderRole {
  CITIZEN
  EMPLOYEE
  SYSTEM
}

enum AttachmentType {
  PHOTO
  VIDEO
}

enum NotificationType {
  GENERAL
  ATTENDANCE
  APPLICATION
  LOCATION
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum ZoneKind {
  DISTRICT
  MAHALLA
}

enum LocationSource {
  FOREGROUND
  BACKGROUND
  MANUAL
}

enum ApplicationEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  MESSAGE
  // Citizen feedback after resolution (rating 1..5) and reopen-if-unhappy.
  RATED
  REOPENED
}

// ---------------------------------------------------------------------------
// Departments (Bo'lim) — organizational units employees belong to and
// applications can be routed to.
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  employees    Employee[]
  applications Application[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Employees (Xodim)
// ---------------------------------------------------------------------------

model Employee {
  id            String       @id @default(uuid())
  fullName      String
  phone         String       @unique
  position      String
  region        String
  district      String
  role          EmployeeRole @default(EMPLOYEE)
  isActive      Boolean      @default(true)
  avatarUrl     String?
  email         String?      @unique
  // Employee login credentials (worker-app): employees sign in with
  // username + password (bcrypt), NOT OTP. Nullable so pre-existing rows and
  // OTP-era employees remain valid until a username/password is provisioned.
  username      String?      @unique
  passwordHash  String?
  departmentId  String?
  workStartTime String       @default("09:00")
  workEndTime   String       @default("18:00")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  // --- Geofence / office assignment (per employee; falls back to global env) ---
  officeLat       Float?
  officeLng       Float?
  officeRadiusM   Int?
  homeMahallaCode String?

  // --- Territory oversight: mahalla codes this employee is assigned to patrol/
  // serve. Empty = the whole district counts as "in zone". A live report is
  // "in zone" when its resolved mahalla is one of these (see locations.service).
  assignedMahallaCodes String[] @default([])

  // --- Denormalized "latest location" for fast admin live-map + stale checks ---
  lastLat            Float?
  lastLng            Float?
  lastAccuracyM      Float?
  lastLocationAt     DateTime?
  lastMahallaCode    String?
  lastMahallaName    String?
  lastInsideDistrict Boolean   @default(false)
  lastInsideOffice   Boolean   @default(false)
  // Whether the latest report fell inside this employee's assigned territory
  // (assignedMahallaCodes; falls back to lastInsideDistrict when unassigned).
  lastInsideAssignedZone Boolean @default(true)
  // Set when a "no location for N minutes" alert has already been raised for the
  // current stale episode, so the scheduler doesn't spam. Cleared on next report.
  staleAlertedAt     DateTime?

  faceTemplates        FaceTemplate[]
  attendanceRecords    AttendanceRecord[]
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  assignedApplications Application[]
  locations            EmployeeLocation[]
  pointsEntries        PointsEntry[]
  suggestions          Suggestion[]
  suggestionVotes      SuggestionVote[]
  leaveRequests        LeaveRequest[]
  bonusRequests        BonusRequest[]
  salaries             EmployeeSalary[]

  @@map("employees")
}

model FaceTemplate {
  id         String   @id @default(uuid())
  employeeId String
  embedding  Float[]
  enrolledAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("face_templates")
}

// ---------------------------------------------------------------------------
// Attendance (Davomat)
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id          String         @id @default(uuid())
  employeeId  String
  type        AttendanceType
  faceScore   Float
  latitude    Float
  longitude   Float
  isValid     Boolean
  reason      String?
  isLate      Boolean        @default(false)
  lateMinutes Int            @default(0)
  // Where the scan was accepted: 'office' (within the employee's office
  // radius) or 'zone' (inside their assigned mahalla). null = rejected /
  // recorded before this field existed.
  place       String?
  // The face frame of this scan (our /uploads), so "kim keldi" is provable.
  photoUrl    String?
  recordedAt  DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, recordedAt])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Applications / Complaints (Murojaat / Ariza)
// ---------------------------------------------------------------------------

model Application {
  id                   String            @id @default(uuid())
  applicantFullName    String
  applicantPhone       String
  subject              String
  description          String
  region               String?
  district             String?
  status               ApplicationStatus @default(NEW)
  assignedEmployeeId   String?
  assignedDepartmentId String?
  // Lifecycle / SLA (all optional — additive). priority drives dueAt on
  // create; resolvedAt is stamped when the assignee resolves it; rating is
  // the citizen's 1..5 feedback after resolution.
  priority             Priority          @default(medium)
  address              String?
  lat                  Float?
  lng                  Float?
  dueAt                DateTime?
  resolvedAt           DateTime?
  rating               Int?
  ratingComment        String?
  kind                 ApplicationKind   @default(ARIZA)
  category             String?
  /// Set once when the SLA was missed and the admins were alerted.
  escalatedAt          DateTime?
  /// How many times the citizen reopened it (capped).
  reopenCount          Int               @default(0)
  /// Selfie taken in the citizen app when filing — "who wrote this".
  applicantPhotoUrl    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assignedEmployee   Employee?            @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedDepartment Department?          @relation(fields: [assignedDepartmentId], references: [id])
  messages           ApplicationMessage[]
  attachments        Attachment[]
  events             ApplicationEvent[]

  @@index([status])
  @@index([applicantPhone])
  @@index([kind])
  @@map("applications")
}

/// In-app notifications for citizens (keyed by the phone their token carries):
/// "qabul qilindi", "xodim biriktirildi", "javob berildi", "hal qilindi", …
model CitizenNotification {
  id            String   @id @default(uuid())
  phone         String
  title         String
  body          String
  applicationId String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([phone, isRead])
  @@map("citizen_notifications")
}

/// The citizen's face, uploaded once at face enrollment (keyed by phone).
/// Every murojaat they file is stamped with it — "shu yuz yozgan".
model CitizenFace {
  phone     String   @id
  photoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("citizen_faces")
}

model ApplicationMessage {
  id            String            @id @default(uuid())
  applicationId String
  senderRole    MessageSenderRole
  senderName    String?
  text          String
  attachmentUrl String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_messages")
}

model Attachment {
  id            String         @id @default(uuid())
  applicationId String
  type          AttachmentType
  url           String
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  uploadedAt    DateTime       @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("attachments")
}

model ApplicationEvent {
  id              String               @id @default(cuid())
  applicationId   String
  type            ApplicationEventType
  fromStatus      ApplicationStatus?
  toStatus        ApplicationStatus?
  fromEmployeeId  String?
  toEmployeeId    String?
  departmentId    String?
  actorEmployeeId String?
  note            String?
  createdAt       DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(uuid())
  employeeId String
  title      String
  body       String
  type       NotificationType @default(GENERAL)
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Push notification device tokens (FCM)
// ---------------------------------------------------------------------------
// One row per installed app instance. The worker-app registers its Firebase
// Cloud Messaging token after login; the backend fans a push out to every
// token an employee owns. Tokens rotate, so `token` is unique and dead tokens
// are pruned automatically when FCM reports them unregistered on send.

model DeviceToken {
  id         String         @id @default(uuid())
  employeeId String
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("device_tokens")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ---------------------------------------------------------------------------
// Auth (phone + SMS OTP)
// ---------------------------------------------------------------------------

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_challenges")
}

model RefreshToken {
  id         String   @id @default(uuid())
  employeeId String
  tokenHash  String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Admin panel users (web-admin login/password auth — separate from employees)
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Zones (Hudud) — administrative boundaries: district (tuman) + mahallas.
// Seeded from real GIS shapefiles (Mirzo Ulug'bek tumani, 70 mahallas).
// `geometry` holds a GeoJSON geometry object (coords in [lng, lat] order).
// ---------------------------------------------------------------------------

model Zone {
  id          String   @id @default(uuid())
  kind        ZoneKind
  code        String   @unique // KOD for mahalla, district code for district
  soato       String?
  nameUzLat   String
  nameUzCyr   String?
  nameRu      String?
  parentCode  String? // mahalla -> district code
  centroidLat Float
  centroidLng Float
  minLat      Float
  minLng      Float
  maxLat      Float
  maxLng      Float
  areaM2      Float?
  geometry    Json // GeoJSON geometry (Polygon | MultiPolygon), [lng, lat]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@map("zones")
}

// ---------------------------------------------------------------------------
// Employee location time-series (doimiy lokatsiya) — one row per GPS report.
// The server derives mahalla + office-geofence membership on ingest.
// ---------------------------------------------------------------------------

model EmployeeLocation {
  id                String         @id @default(uuid())
  employeeId        String
  latitude          Float
  longitude         Float
  accuracy          Float?
  speed             Float?
  heading           Float?
  battery           Int?
  source            LocationSource @default(FOREGROUND)
  mahallaCode       String?
  mahallaName       String?
  insideDistrict    Boolean        @default(false)
  insideOffice      Boolean        @default(false)
  insideAssignedZone Boolean       @default(true)
  distanceToOfficeM Float?
  recordedAt        DateTime // device timestamp
  createdAt         DateTime       @default(now()) // server receive timestamp

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, recordedAt])
  @@map("employee_locations")
}

// ---------------------------------------------------------------------------
// Monthly salary (Oylik maosh) — one row per employee per calendar month.
// `amount` is the base salary; `bonus`/`penalty` adjust it; `net` is derived
// (amount + bonus - penalty) in the serializer. Set/edited from web-admin.
// ---------------------------------------------------------------------------
model EmployeeSalary {
  id         String    @id @default(uuid())
  employeeId String
  year       Int
  month      Int // 1..12
  amount     Int // base salary for the month, so'm (UZS)
  bonus      Int       @default(0)
  penalty    Int       @default(0)
  note       String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@map("employee_salaries")
}

// ===========================================================================
// WEB-ADMIN DOMAIN MODELS
// ---------------------------------------------------------------------------
// These models mirror the web-admin mock contract
// (apps/web-admin/src/shared/data/{types,mock}.ts). Every endpoint that serves
// one of these must return JSON that is a drop-in replacement for the matching
// mock export: identical field names + nesting, dates as ISO strings, and the
// literal enum values below (kept lowercase on purpose so the JSON matches the
// TypeScript union types exactly — e.g. status "in_progress", category
// "kommunal"). Enum member names double as the wire value; do NOT @map them.
//
// Nested value-objects (attendance days, worker documents, complaint responses,
// app-user activity points, staff schedule, district center/polygon) are stored
// as Json so the persisted shape is byte-identical to the mock's nested arrays.
//
// Large monetary figures (utility/finance) use Float, not Int/BigInt: the values
// exceed the 32-bit Int range, and Float serialises cleanly to a JSON number
// (BigInt would throw in JSON.stringify and break the drop-in contract).
//
// NOTE: all admin endpoints backed by these models are @Public() for this TEST
// deployment; auth-gating them is a later config step.
// ===========================================================================

// ---- Enums (lowercase literals mirror the web-admin TS unions) -------------

enum RequestCategory {
  kommunal
  yol
  suv
  elektr
  tozalik
  obodonlashtirish
}

enum RequestStatus {
  new
  in_progress
  resolved
  rejected
}

enum Priority {
  low
  medium
  high
}

enum WorkerStatus {
  online
  offline
  on_task
  break
}

enum UtilityType {
  suv
  gaz
  elektr
  issiqlik
  tozalik
  internet
}

enum CameraType {
  fixed
  ptz
  anpr
  thermal
}

enum CameraStatus {
  online
  offline
  maintenance
}

enum GovDocType {
  qaror
  buyruq
  hisobot
  shartnoma
  ariza
  dalolatnoma
}

enum GovDocStatus {
  draft
  review
  signed
  archived
}

enum StaffRole {
  hokim
  hokim_yordamchisi
  bolim_boshligi
  operator
  nazoratchi
  ishchi
}

enum StaffStatus {
  active
  inactive
  suspended
}

enum ModuleKey {
  dashboard
  requests
  map
  workers
  attendance
  staff
  cameras
  finance
  analytics
  documents
  news
  settings
}

enum NewsCategory {
  elon
  tadbir
  qaror
  ogohlantirish
  yangilik
}

enum NewsStatus {
  published
  draft
}

enum AppUserStatus {
  active
  inactive
  blocked
}

enum AppUserDevice {
  android
  ios
}

enum AdminNotificationType {
  request
  worker
  finance
  camera
  system
}

enum ComplaintStatus {
  new
  reviewing
  resolved
  rejected
}

enum ComplaintSeverity {
  low
  medium
  high
}

enum MeetingType {
  apparat
  qabul
  shtab
  video
  hashar
}

enum MeetingStatus {
  scheduled
  ongoing
  done
  cancelled
}

// ---- District (Tuman) ------------------------------------------------------
// id is the stable slug ("mirzo", "chilonzor", ...). center = [lat,lng];
// polygon = [lat,lng][] — both kept as Json to preserve the tuple shape.

model District {
  id         String   @id
  name       String
  center     Json // [lat, lng]
  polygon    Json // [lat, lng][]
  color      String
  population Int
  households Int
  areaKm2    Float
  createdAt  DateTime @default(now())

  @@map("districts")
}

// ---- Worker (dala ishchisi) ------------------------------------------------

model Worker {
  id             String            @id // "w1"
  name           String
  photo          String
  avatarColor    String
  position       String
  region         String
  districtId     String
  phone          String
  email          String
  specialization RequestCategory[]
  status         WorkerStatus
  insideRegion   Boolean
  rating         Float
  points         Int
  completedTasks Int
  activeTasks    Int
  lat            Float
  lng            Float
  hiredAt        DateTime
  checkInTime    String? // "08:12" (clock time, not a date)
  checkOutTime   String?
  todayConfirmed Boolean
  attendanceRate Int
  onTimeRate     Int
  monthlyHours   Int
  attendance     Json // AttendanceDay[]
  salary         Int
  bonus          Int
  vehicle        String?
  documents      Json // WorkerDocument[]
  createdAt      DateTime          @default(now())

  @@index([districtId])
  @@index([status])
  @@map("workers")
}

// ---- CitizenRequest (Murojaat) — the REQUESTS export -----------------------

model CitizenRequest {
  id               String          @id // "R-1000"
  title            String
  description      String
  category         RequestCategory
  status           RequestStatus
  region           String
  districtId       String
  address          String
  citizenName      String
  citizenPhone     String
  citizenPhoto     String
  createdAt        DateTime
  resolvedAt       DateTime?
  assignedWorkerId String?
  priority         Priority
  lat              Float
  lng              Float
  photos           String[]
  responseHours    Int?
  feedback         Int?
  cost             Int

  @@index([status])
  @@index([category])
  @@index([districtId])
  @@map("citizen_requests")
}

// ---- Staff (Xodim / tizim foydalanuvchisi) ---------------------------------

model Staff {
  id          String      @id // "s1"
  name        String
  photo       String
  avatarColor String
  role        StaffRole
  position    String
  department  String
  email       String
  phone       String
  login       String
  status      StaffStatus
  permissions ModuleKey[]
  schedule    Json // { start, end, days: number[] }
  lastLogin   DateTime?
  createdAt   DateTime
  twoFactor   Boolean

  @@index([role])
  @@index([status])
  @@map("staff")
}

// ---- Deputy (Hokim o'rinbosari) --------------------------------------------

model Deputy {
  id             String            @id // "d1"
  name           String
  photo          String
  color          String
  position       String
  direction      String
  shortDirection String
  categories     RequestCategory[]
  topics         String[]
  phone          String
  email          String
  office         String
  receptionDay   String

  @@map("deputies")
}

// ---- Complaint (Shikoyat) — responses[] stored as Json ---------------------

model Complaint {
  id           String            @id // "SH-2000"
  title        String
  description  String
  topic        String
  severity     ComplaintSeverity
  status       ComplaintStatus
  districtId   String
  region       String
  address      String
  citizenName  String
  citizenPhone String
  citizenPhoto String
  createdAt    DateTime
  deadlineAt   DateTime
  resolvedAt   DateTime?
  deputyId     String
  isRepeat     Boolean
  escalated    Boolean
  responses    Json // ComplaintResponse[]
  // Nullable: existing rows predate this column, so it stays optional with no
  // default (a required default would break `prisma db push` on old data).
  category     RequestCategory?

  messages ComplaintMessage[]

  @@index([status])
  @@index([deputyId])
  @@map("complaints")
}

// ---- ComplaintMessage / ComplaintAttachment (admin<->citizen media thread) --
// Mirrors the Application `messages`/`attachments` shape so mobile/web clients
// can reuse the same rendering code across murojaat and complaints.

model ComplaintMessage {
  id          String   @id @default(cuid())
  complaintId String
  authorType  String   @default("ADMIN") // "ADMIN" | "CITIZEN" | "STAFF"
  authorName  String
  text        String?
  createdAt   DateTime @default(now())

  complaint   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  attachments ComplaintAttachment[]

  @@index([complaintId])
  @@map("complaint_messages")
}

model ComplaintAttachment {
  id        String         @id @default(cuid())
  messageId String
  type      AttachmentType
  url       String
  fileName  String?
  mimeType  String?
  sizeBytes Int?

  message ComplaintMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("complaint_attachments")
}

// ---- AppUser (Mobil ilova foydalanuvchisi) — activity[] as Json ------------

model AppUser {
  id              String        @id // "au1"
  name            String
  phone           String
  photo           String
  avatarColor     String
  region          String
  districtId      String
  address         String
  device          AppUserDevice
  appVersion      String
  status          AppUserStatus
  verified        Boolean
  registeredAt    DateTime
  lastActiveAt    DateTime
  requestsCount   Int
  resolvedCount   Int
  avgRating       Float
  points          Int
  notificationsOn Boolean
  activity        Json // AppUserActivityPoint[]

  @@index([status])
  @@map("app_users")
}

// ---- AdminNotification (web-admin NotificationItem) ------------------------
// Named AdminNotification to avoid clashing with the existing employee-facing
// `Notification` model. JSON shape still matches the mock's NotificationItem.

model AdminNotification {
  id        String                @id // "ntf1"
  type      AdminNotificationType
  title     String
  message   String
  createdAt DateTime
  read      Boolean               @default(false)
  href      String?

  @@map("admin_notifications")
}

// ---- Camera (CCTV) — Tier 2 ------------------------------------------------

model Camera {
  id            String       @id // "CAM-01"
  name          String
  region        String
  districtId    String
  type          CameraType
  status        CameraStatus
  lat           Float
  lng           Float
  resolution    String
  recording     Boolean
  uptime        Float
  detections24h Int
  lastEvent     String?
  installedAt   DateTime

  @@index([status])
  @@index([districtId])
  @@map("cameras")
}

// ---- Meeting (Yig'ilish) — Tier 2 ------------------------------------------

model Meeting {
  id            String        @id // "YIG-3000"
  title         String
  type          MeetingType
  status        MeetingStatus
  startAt       DateTime
  durationMin   Int
  location      String
  chairDeputyId String
  /** Raislik qiluvchining ismi (chairDeputyId endi Deputy jadvaliga bog'liq emas). */
  chairName     String?
  agenda        String[]
  participants  Int
  /** Ishtirokchilarning ismlari (real xodimlar) — detailda ro'yxat sifatida ko'rsatiladi. */
  participantNames String[] @default([])
  districtId    String

  @@index([status])
  @@map("meetings")
}

// ---- NewsItem (Yangilik / e'lon) — Tier 2 ----------------------------------

model NewsItem {
  id          String       @id // "n1"
  title       String
  excerpt     String
  body        String
  category    NewsCategory
  status      NewsStatus
  cover       String
  author      String
  publishedAt DateTime
  views       Int
  featured    Boolean

  @@index([status])
  @@index([category])
  @@map("news_items")
}

// ---- GovDocument (Hokimiyat hujjati) — Tier 2 ------------------------------

model GovDocument {
  id        String       @id // "D-1"
  code      String
  title     String
  type      GovDocType
  status    GovDocStatus
  author    String
  region    String
  createdAt DateTime
  sizeKb    Int
  pages     Int

  @@index([type])
  @@index([status])
  @@map("gov_documents")
}

// ---- Utility & Finance monthly series — Tier 2 -----------------------------
// Large sums use Float (see header note on BigInt/JSON).

model UtilityPayment {
  id             String      @id // "olmazor-suv"
  type           UtilityType
  region         String
  districtId     String
  period         String // "2026-05"
  charged        Float
  collected      Float
  debt           Float
  households     Int
  collectionRate Float

  @@index([districtId])
  @@index([type])
  @@map("utility_payments")
}

model UtilityMonthly {
  month    String @id // "Iyul"
  suv      Float
  gaz      Float
  elektr   Float
  issiqlik Float
  tozalik  Float
  internet Float

  @@map("utility_monthly")
}

model FinanceMonthly {
  month     String @id // "Iyul"
  budget    Float
  spent     Float
  collected Float
  turnover  Float

  @@map("finance_monthly")
}

// ---- Chat (Suhbat) — group + direct staff conversations --------------------
// Mirrors web-admin's `shared/store/chat.ts` (`Conversation` / `ChatMessage`)
// exactly: field names/nesting match 1:1 so API responses are a drop-in
// replacement for the old in-store mock data. Enum member names double as the
// wire value (lowercase on purpose), same convention as the rest of this
// admin domain — do NOT @map them.

enum ChatConvKind {
  group
  direct
}

enum ChatMsgKind {
  text
  image
  file
  voice
  // Telegram-style round video note (has url + durationSec, like voice).
  video
  // System row written by the realtime gateway when a 1:1 call between the
  // admin and an employee finishes — so calls show up in the chat history.
  // `meta` = { callId, media: 'audio'|'video', status, durationSec }.
  call
}

enum ChatMsgStatus {
  sent
  delivered
  read
}

model ChatConversation {
  id          String       @id // "group-all" | "dm-<staffId>"
  kind        ChatConvKind
  title       String
  subtitle    String?
  avatarColor String?
  photo       String?
  staffId     String? // only for kind = direct
  online      Boolean      @default(false)
  // Archive: "clear chat" (tozalash) empties messages AND sets archived=true;
  // the main list requests archived=false, the Archive view requests true.
  archived    Boolean      @default(false)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages ChatMessage[]

  @@index([kind])
  @@index([archived])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String // "me" (admin) or a staff id
  kind           ChatMsgKind
  text           String?
  fileName       String?
  fileSize       Int?
  url            String?
  durationSec    Int?
  status         ChatMsgStatus @default(sent)
  // Set when the body was edited (allowed only while status != read).
  editedAt       DateTime?
  // Structured payload for system kinds (kind = call: callId/media/status/durationSec).
  meta           Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// Per-reader "read up to" cursor. `ChatMessage.status` is a single per-message
// field, which is right for a 1:1 DM but wrong for the group thread: one
// employee reading `group-all` would zero everyone's unread badge. Group
// unread counts are therefore derived from each reader's own cursor.
model ChatReadCursor {
  conversationId String
  readerId       String // "me" (admin) or an employee id
  lastReadAt     DateTime @default(now())

  @@id([conversationId, readerId])
  @@map("chat_read_cursors")
}

// ---------------------------------------------------------------------------
// Call log (Qo'ng'iroqlar tarixi) — 1:1 WebRTC voice/video signaling history.
// The backend only relays SDP/ICE + records the call lifecycle here; media is
// peer-to-peer. Feeds the call-history UI (missed/incoming/outgoing badges).
// ---------------------------------------------------------------------------
model CallLog {
  id          String    @id @default(uuid())
  callerId    String
  callerName  String
  calleeId    String
  calleeName  String
  media       String // 'audio' | 'video'
  // ringing | accepted | rejected | missed | cancelled | ended | busy
  status      String
  startedAt   DateTime  @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int       @default(0)

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@map("call_logs")
}

// ---------------------------------------------------------------------------
// Employee points / rating (Ball nazorati — worker-app)
// ---------------------------------------------------------------------------

model PointsEntry {
  id         String   @id @default(uuid())
  employeeId String
  reason     String
  delta      Int
  positive   Boolean
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("points_entries")
}

// ---------------------------------------------------------------------------
// Employee rationalization suggestions (Takliflar — worker-app)
// ---------------------------------------------------------------------------

enum SuggestionStatus {
  yangi
  korilmoqda
  qabulQilindi
  rad
}

model Suggestion {
  id        String           @id @default(uuid())
  authorId  String
  title     String
  body      String
  category  String
  status    SuggestionStatus @default(yangi)
  votes     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author      Employee         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  voteRecords SuggestionVote[]

  @@index([status])
  @@map("suggestions")
}

model SuggestionVote {
  id           String   @id @default(uuid())
  suggestionId String
  employeeId   String
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, employeeId])
  @@index([suggestionId])
  @@map("suggestion_votes")
}

// ---------------------------------------------------------------------------
// Employee leave requests (Ta'til / ruxsat so'rovi — worker-app)
// ---------------------------------------------------------------------------

enum LeaveType {
  hours
  days
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  amount     Int
  startDate  DateTime
  startTime  String?
  reason     String
  status     LeaveStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Employee bonuses (Premya — admin-granted, web-admin write / worker-app read)
// ---------------------------------------------------------------------------

model Bonus {
  id            String   @id @default(uuid())
  employeeId    String?
  workerId      String?
  recipientName String
  amount        Int
  reason        String
  month         String
  type          String   @default("premya")
  createdAt     DateTime @default(now())
  // @default(now()) so `db push` can add this to the already-populated bonuses
  // table (existing rows get now()); @updatedAt bumps it on every edit.
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("bonuses")
}

// Employee-initiated bonus REQUESTS (worker-app "Premya so'rash"): the employee
// asks for a premya; an admin later approves/rejects. Distinct from `Bonus`
// above, which is an admin-GRANTED award the employee only views.
enum BonusStatus {
  pending
  approved
  rejected
}

model BonusRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Int?
  reason     String
  status     BonusStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@index([employeeId])
  @@map("bonus_requests")
}

// ---------------------------------------------------------------------------
// OAV monitoringi (media monitoring) — every 15 min the backend collects news
// about the district from news sites (RSS), Telegram channels, Google News,
// YouTube and Instagram, scores each item (relevance / sentiment / topic) and
// writes an AI xulosa (digest) for the hokim's dashboard.
// ---------------------------------------------------------------------------
enum MediaSentiment {
  positive
  neutral
  negative
}

enum MediaItemStatus {
  new
  seen
  important
  hidden
}

model MediaItem {
  id          String          @id @default(cuid())
  /// Collector key: "rss:kunuz", "tg:daryo", "google", "youtube", "instagram" ...
  source      String
  /// Display name of the outlet / channel ("Kun.uz", "Daryo | Rasmiy kanal").
  sourceName  String
  /// web | telegram | youtube | instagram
  platform    String
  externalId  String
  url         String
  title       String
  excerpt     String?         @db.Text
  imageUrl    String?
  author      String?
  views       Int?
  publishedAt DateTime
  fetchedAt   DateTime        @default(now())
  /// Normalised title prefix — the same story from kun.uz RSS and Google News is stored once.
  fingerprint String
  /// Configured keywords that matched the text.
  keywords    String[]
  /// 0..100 — how surely this is about the district (not the astronomer / a street name).
  relevance   Int             @default(50)
  /// 0..100 — about Toshkent shahri (any of its 12 districts, ours included). See media-area.ts.
  cityRelevance   Int         @default(0)
  /// 0..100 — about Toshkent viloyati (Chirchiq, Angren, Zangiota ...).
  regionRelevance Int         @default(0)
  sentiment   MediaSentiment  @default(neutral)
  topic       String?
  aiSummary   String?         @db.Text
  /// "ai" (Claude) or "rules" (offline lexicon) — so the UI can say how it was scored.
  analyzedBy  String?
  /// Published by a state body (gov.uz agency, President's press office, UzA, parliament, hokimlik).
  official    Boolean         @default(false)
  /// Same event across outlets (media-story.ts): the lead is shown, the rest as "+N manbada".
  storyId     String?
  isStoryLead Boolean         @default(true)
  status      MediaItemStatus @default(new)

  @@unique([source, externalId])
  @@index([publishedAt])
  @@index([fingerprint])
  @@index([storyId])
  @@map("media_items")
}

model MediaDigest {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  periodFrom      DateTime
  periodTo        DateTime
  itemCount       Int
  positive        Int      @default(0)
  neutral         Int      @default(0)
  negative        Int      @default(0)
  headline        String
  summary         String   @db.Text
  /// [{ name, count, sentiment }]
  topics          Json
  /// [{ title, detail, level: high|medium|low, itemIds: string[] }]
  risks           Json
  /// string[]
  recommendations Json
  /// Claude model id, or "rules" when no ANTHROPIC_API_KEY is configured.
  model           String

  @@index([createdAt])
  @@map("media_digests")
}

model MediaSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("media_settings")
}
