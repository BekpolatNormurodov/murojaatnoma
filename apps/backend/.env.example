# App
NODE_ENV=development
PORT=3000

# Database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hokimiyat?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Auth / OTP
OTP_TTL_SECONDS=120

# Attendance business rules
FACE_MATCH_THRESHOLD=0.7
GEOFENCE_RADIUS_M=150
OFFICE_LATITUDE=41.311081
OFFICE_LONGITUDE=69.240562
