# Copy this file to infra/.env and fill in real values.
# infra/.env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------
POSTGRES_USER=gov_admin
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=gov_system

# ---------------------------------------------------------------------
# Backend (NestJS) — host "postgres" matches the compose service name.
# ---------------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=postgresql://gov_admin:changeme_use_a_strong_password@postgres:5432/gov_system?schema=public

JWT_ACCESS_SECRET=changeme_generate_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=changeme_generate_with_openssl_rand_base64_48
JWT_REFRESH_EXPIRES_IN=7d

# Origin(s) allowed to call the API. With no domain yet, use the gateway's
# public IP over https (self-signed cert). Update once a domain is added.
CORS_ORIGIN=https://192.168.210.12

# ---------------------------------------------------------------------
# Used only by infra/scripts/gen-selfsigned.sh to set the cert's CN/SAN.
# ---------------------------------------------------------------------
SERVER_IP=192.168.210.12
